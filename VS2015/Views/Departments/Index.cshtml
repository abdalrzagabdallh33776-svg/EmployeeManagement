@model IEnumerable<EmployeeManagement.Models.Department>
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewBag.Title="الأقسام"; }<h2>الأقسام</h2><a class="btn btn-primary" href="~/Departments/Create">إضافة قسم</a><table class="table"><tr><th>الاسم</th><th>الوصف</th><th>الموظفون</th><th>إجراءات</th></tr>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Description</td><td>@x.Employees.Count</td><td><a href="~/Departments/Edit/@x.Id">تعديل</a> | <form style="display:inline" method="post" action="~/Departments/Delete/@x.Id"><button class="btn-link">حذف</button></form></td></tr>}</table>