@model IEnumerable<EmployeeManagement.Models.Employee>
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewBag.Title="الموظفون"; }<div class="clearfix"><h2 class="pull-right">الموظفون</h2><a class="btn btn-primary pull-left" href="~/Employees/Create">إضافة موظف</a></div><form method="get" class="form-inline"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث"/> <button class="btn btn-default">بحث</button></form><table class="table table-striped"><tr><th>الاسم</th><th>البريد</th><th>الوظيفة</th><th>القسم</th><th>الراتب</th><th>إجراءات</th></tr>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td>@x.Position</td><td>@x.Department.Name</td><td>@x.Salary</td><td><a href="~/Employees/Edit/@x.Id">تعديل</a> | <form style="display:inline" method="post" action="~/Employees/Delete/@x.Id"><button class="btn-link">حذف</button></form></td></tr>}</table>