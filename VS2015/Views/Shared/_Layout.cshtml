@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><title>@ViewBag.Title - إدارة الموظفين</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/Content/Site.css"/></head><body><nav class="navbar navbar-inverse"><div class="container"><a class="navbar-brand" href="~/">إدارة الموظفين</a><ul class="nav navbar-nav"><li><a href="~/Employees">الموظفون</a></li>@if (User.IsInRole("مدير")) {<li><a href="~/Departments">الأقسام</a></li><li><a href="~/Users">المستخدمون</a></li>}</ul><ul class="nav navbar-nav navbar-right"><li><a href="#">@User.Identity.Name (@(User.IsInRole("مدير") ? "مدير" : "موظف"))</a></li><li><a href="~/Account/Logout">خروج</a></li></ul></div></nav><div class="container body-content">@RenderBody()<hr/><footer>نظام إدارة الموظفين</footer></div></body></html>
