@model IEnumerable<EmployeeManagement.Models.Department>
@{ ViewData["Title"] = "الأقسام"; }<div class="d-flex justify-content-between mb-3"><h2>الأقسام</h2><a class="btn btn-primary" asp-action="Create">إضافة قسم</a></div><table class="table table-bordered"><thead><tr><th>القسم</th><th>الوصف</th><th>عدد الموظفين</th><th>إجراءات</th></tr></thead><tbody>@foreach (var d in Model) {<tr><td>@d.Name</td><td>@d.Description</td><td>@d.Employees.Count</td><td><a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@d.Id">تعديل</a> <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"><button class="btn btn-sm btn-danger">حذف</button></form></td></tr>}</tbody></table>
