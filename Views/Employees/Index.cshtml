@model IEnumerable<EmployeeManagement.Models.Employee>
@{ ViewData["Title"] = "الموظفون"; }<div class="d-flex justify-content-between mb-3"><h2>الموظفون</h2><a class="btn btn-primary" asp-action="Create">إضافة موظف</a></div><form class="row g-2 mb-3"><div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو البريد" /></div><div class="col-auto"><button class="btn btn-secondary">بحث</button></div></form><table class="table table-striped table-bordered"><thead><tr><th>الاسم</th><th>البريد</th><th>الوظيفة</th><th>القسم</th><th>الراتب</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody>@foreach (var e in Model) {<tr><td>@e.FullName</td><td>@e.Email</td><td>@e.Position</td><td>@e.Department?.Name</td><td>@e.Salary.ToString("N2")</td><td>@e.Status</td><td><a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@e.Id">تعديل</a> <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@e.Id">حذف</a></td></tr>}</tbody></table>
