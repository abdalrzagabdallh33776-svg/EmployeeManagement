@model EmployeeManagement.Models.Employee
<form asp-action="@(ViewContext.RouteData.Values["action"])" method="post"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="Position"></label><input asp-for="Position" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Salary"></label><input asp-for="Salary" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="HireDate"></label><input asp-for="HireDate" type="date" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>نشط</option><option>غير نشط</option><option>في إجازة</option></select></div><div class="col-md-6 mb-3"><label asp-for="DepartmentId">القسم</label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">اختر القسم</option></select></div></div><button class="btn btn-success">حفظ</button> <a asp-action="Index" class="btn btn-secondary">عودة</a></form>
